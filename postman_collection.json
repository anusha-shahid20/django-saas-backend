{
    "info": {
        "name": "Django SaaS Backend",
        "description": "API collection for the multi-tenant SaaS backend",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000",
            "type": "string"
        },
        {
            "key": "access_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"your_password\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/token/",
                            "host": ["{{base_url}}"],
                            "path": ["api", "token", ""]
                        }
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refresh\": \"your_refresh_token\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/token/refresh/",
                            "host": ["{{base_url}}"],
                            "path": ["api", "token", "refresh", ""]
                        }
                    }
                }
            ]
        },
        {
            "name": "Projects",
            "item": [
                {
                    "name": "List Projects",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tasks/api/projects/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "projects", ""]
                        }
                    }
                },
                {
                    "name": "Create Project",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"New Project\",\n    \"description\": \"Project description\",\n    \"status\": \"pending\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/tasks/api/projects/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "projects", ""]
                        }
                    }
                },
                {
                    "name": "Get Project Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tasks/api/projects/1/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "projects", "1", ""]
                        }
                    }
                },
                {
                    "name": "Update Project",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Updated Project\",\n    \"description\": \"Updated description\",\n    \"status\": \"in_progress\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/tasks/api/projects/1/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "projects", "1", ""]
                        }
                    }
                },
                {
                    "name": "Delete Project",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tasks/api/projects/1/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "projects", "1", ""]
                        }
                    }
                }
            ]
        },
        {
            "name": "Tasks",
            "item": [
                {
                    "name": "List Tasks",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tasks/api/tasks/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "tasks", ""]
                        }
                    }
                },
                {
                    "name": "Create Task",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"New Task\",\n    \"description\": \"Task description\",\n    \"project\": 1,\n    \"status\": \"pending\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/tasks/api/tasks/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "tasks", ""]
                        }
                    }
                },
                {
                    "name": "Update Task Status",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"completed\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/tasks/api/tasks/1/status/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "tasks", "1", "status", ""]
                        }
                    }
                },
                {
                    "name": "Delete Task",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/tasks/api/tasks/1/",
                            "host": ["{{base_url}}"],
                            "path": ["tasks", "api", "tasks", "1", ""]
                        }
                    }
                }
            ]
        }
    ]
}